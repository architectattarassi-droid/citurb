# ─────────────────────────────────────────────────────────────────────────────
# DEV LOCAL CONFIG (copy to .env)
#
# Start everything:
#   npm install
#   npm run dev              # API + front-office
#   npm --workspace apps/ops run dev   # OPS back-office (separate terminal)
#
# URLs:
#   Front-office: http://localhost:5173
#   OPS back-office: http://localhost:5174
#   API: http://localhost:4000
# ─────────────────────────────────────────────────────────────────────────────
# API
PORT=3000
# Database
# 1) Ensure PostgreSQL is running (ex: localhost:5432)
# 2) Create the database (ex: citurbarea)
# 3) Enable PostGIS in that database (required for geometry type):
#      CREATE EXTENSION IF NOT EXISTS postgis;
# 4) Then run from repo root:
#      npm run dev
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/citurbarea?schema=public"
# Dev bootstrap owner (GET /auth/dev/ensure-owner)
# Preferred names:
CIT_OWNER_EMAIL=owner@citurbarea.local
CIT_OWNER_PASSWORD=ChangeMeNow!
# Optional: seed additional privileged accounts during the same bootstrap call
# If set, /auth/dev/ensure-owner will also create/update these users.
CIT_ADMIN_EMAIL=admin@citurbarea.local
CIT_ADMIN_PASSWORD=ChangeMeNow!
CIT_OPS_EMAIL=ops@citurbarea.local
CIT_OPS_PASSWORD=ChangeMeNow!
# Alternate aliases expected by older code (optional)
OWNER_EMAIL=${CIT_OWNER_EMAIL}
OWNER_PASSWORD=${CIT_OWNER_PASSWORD}
ADMIN_EMAIL=${CIT_ADMIN_EMAIL}
ADMIN_PASSWORD=${CIT_ADMIN_PASSWORD}
OPS_EMAIL=${CIT_OPS_EMAIL}
OPS_PASSWORD=${CIT_OPS_PASSWORD}
# Backward-compatible aliases (optional)
DEV_OWNER_EMAIL=owner@citurbarea.local
DEV_OWNER_PASSWORD=ChangeMeNow!
# Front-office (apps/web)
VITE_API_URL=http://localhost:4000
# OPS back-office (apps/ops)
VITE_API_BASE=http://localhost:4000
VITE_OPS_EMAIL=${CIT_OWNER_EMAIL}
VITE_OPS_PASSWORD=${CIT_OWNER_PASSWORD}
# Option: default OPS login as OPS user instead of OWNER
# VITE_OPS_EMAIL=${CIT_OPS_EMAIL}
# VITE_OPS_PASSWORD=${CIT_OPS_PASSWORD}
SHADOW_DATABASE_URL="postgresql://postgres:StrongPass_2026%21@localhost:5432/citurbarea_shadow"
DOSSIERS_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/citurbarea?schema=public"
JWT_SECRET=dev_secret

# === Cercles / LiveKit (Sprint C0–C3) ===
LIVEKIT_HOST=https://livekit.cercles.citurbarea.com
LIVEKIT_WS_URL=wss://livekit.cercles.citurbarea.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Egress (recording + multi-RTMP, Sprint C4)
LIVEKIT_EGRESS_S3_ENDPOINT=https://minio.cercles.citurbarea.com
LIVEKIT_EGRESS_S3_BUCKET=cercles-recordings
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET_KEY=

# Chiffrement stream keys (AES-256-GCM) — 32 bytes hex
# Génération : openssl rand -hex 32
CERCLES_STREAM_KEY_ENC_KEY=

# Frontend Cercles
VITE_LIVEKIT_WS_URL=wss://livekit.cercles.citurbarea.com
VITE_CERCLES_BASE_URL=https://cercles.citurbarea.com
