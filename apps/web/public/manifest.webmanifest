{
  "name": "CITURBAREA — Expertise BTP & Immobilier Maroc",
  "short_name": "CITURBAREA",
  "description": "Plateforme marocaine d'expertise BTP, immobilier et urbanisme. Permis, expertise foncière, marchés de travaux, réseau pro.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0B1B3A",
  "theme_color": "#0B1B3A",
  "lang": "fr",
  "dir": "auto",
  "categories": ["business", "productivity", "finance"],
  "icons": [
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Nouveau dossier", "short_name": "Nouveau", "url": "/portail", "icons": [{ "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "Mes dossiers", "short_name": "Dossiers", "url": "/dossiers", "icons": [{ "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "Cercles", "short_name": "Cercles", "url": "/cercles", "icons": [{ "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "Explorateur SIG", "short_name": "SIG", "url": "/sig", "icons": [{ "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }] }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "files", "accept": ["image/*", "application/pdf"] }
      ]
    }
  },
  "prefer_related_applications": false
}
