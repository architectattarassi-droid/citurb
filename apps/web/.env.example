# TerriScan Lab — Assistant IA Anthropic (dev local uniquement)
# En production: utiliser le proxy NestJS /api/llm/chat (cf. AGENT ETA)
VITE_ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# ─── Umami analytics (tracking SPA, sans cookies) ────────────────────────
# Injecté dans index.html au build. Si vide → aucun tracking (pas de balise cassée).
# VITE_UMAMI_SCRIPT_URL : URL du script Umami, ex https://umami.xxx.up.railway.app/script.js
# VITE_UMAMI_WEBSITE_ID : même id que UMAMI_WEBSITE_ID côté API.
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=

# ─── Umami pour les pages SEO statiques (build-seo.mjs, Node) ─────────────
# Mêmes valeurs, mais lues côté Node au build (pas de préfixe VITE_).
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
