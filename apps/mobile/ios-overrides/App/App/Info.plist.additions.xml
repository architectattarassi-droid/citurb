<?xml version="1.0" encoding="UTF-8"?>
<!--
  Additions Info.plist iOS — CITURBAREA Mobile

  Ces clés DOIVENT être mergées dans `ios/App/App/Info.plist` après `npx cap add ios`.

  Apple rejette toute app qui accède à Location/Camera/Photos/Microphone/Bluetooth
  SANS chaîne d'explication user-facing. Les strings ci-dessous sont en français
  (locale principale Maroc) — pour i18n EN/AR ajouter aux InfoPlist.strings.

  Workflow d'intégration :
    1. `npx cap add ios`
    2. Ouvrir `ios/App/App/Info.plist` dans Xcode
    3. Copier-coller les clés ci-dessous dans le <dict> racine
    4. (Optionnel) Auto-merge via le script scripts/merge-ios-plist.sh

  @see https://developer.apple.com/documentation/bundleresources/information_property_list
-->
<plist version="1.0">
<dict>
    <!-- =================================================== -->
    <!-- LOCALISATION                                         -->
    <!-- Utilisé par : zones urbanisme P2, terrains P4,       -->
    <!--               PV chantier géotagués P3, rapports P5. -->
    <!-- =================================================== -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>CITURBAREA utilise votre position pour identifier les zones d'urbanisme et terrains de votre dossier.</string>

    <!-- Pas de "Always" — on demande JAMAIS la geo en background -->

    <!-- =================================================== -->
    <!-- CAMÉRA                                               -->
    <!-- Utilisé par : photos chantier géolocalisées,         -->
    <!--               scan CIN onboarding KYC,               -->
    <!--               capture rapports P5.                   -->
    <!-- =================================================== -->
    <key>NSCameraUsageDescription</key>
    <string>CITURBAREA utilise la caméra pour capturer photos de chantier géolocalisées + scan CIN onboarding.</string>

    <!-- =================================================== -->
    <!-- PHOTOTHÈQUE (Lecture)                                -->
    <!-- Utilisé par : import photos existantes vers dossier. -->
    <!-- =================================================== -->
    <key>NSPhotoLibraryUsageDescription</key>
    <string>CITURBAREA accède à vos photos pour les joindre à vos dossiers et PV de chantier.</string>

    <!-- =================================================== -->
    <!-- PHOTOTHÈQUE (Écriture)                               -->
    <!-- Utilisé par : sauvegarde des rapports PDF générés    -->
    <!--               (rapports P4 watermarqués notamment).  -->
    <!-- =================================================== -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>CITURBAREA sauvegarde les rapports PDF générés dans votre photothèque.</string>

    <!-- =================================================== -->
    <!-- MICROPHONE                                           -->
    <!-- Utilisé par : notes vocales chantier (transcription  -->
    <!--               Whisper côté serveur),                 -->
    <!--               visio Cercles BTP (LiveKit + Jitsi).   -->
    <!-- =================================================== -->
    <key>NSMicrophoneUsageDescription</key>
    <string>CITURBAREA utilise le microphone pour les notes vocales de chantier et la visio Cercles.</string>

    <!-- =================================================== -->
    <!-- RÉSEAU LOCAL                                         -->
    <!-- Utilisé par : détection serveurs locaux mode chantier -->
    <!--               offline (sync différée + capture PV).  -->
    <!-- =================================================== -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>CITURBAREA détecte les serveurs locaux pour le mode chantier hors-ligne.</string>

    <!-- =================================================== -->
    <!-- FACE ID / TOUCH ID                                   -->
    <!-- Utilisé par : déverrouillage app, confirmation       -->
    <!--               paiement Stripe avant checkout.        -->
    <!-- =================================================== -->
    <key>NSFaceIDUsageDescription</key>
    <string>CITURBAREA utilise Face ID pour sécuriser l'accès à vos dossiers et paiements.</string>

    <!-- =================================================== -->
    <!-- ATS (App Transport Security)                         -->
    <!-- HTTPS-only strict. Pas d'exception en prod.          -->
    <!-- =================================================== -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <!-- LiveKit + Jitsi utilisent TLS strict — pas d'exception nécessaire -->
    </dict>

    <!-- =================================================== -->
    <!-- DEEP LINKS (URL Scheme)                              -->
    <!-- citurbarea://dossier/abc → ouvre /dossier/abc        -->
    <!-- =================================================== -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>com.citurbarea.app</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>citurbarea</string>
            </array>
        </dict>
    </array>

    <!-- =================================================== -->
    <!-- UNIVERSAL LINKS (Associated Domains)                 -->
    <!-- À configurer aussi côté Entitlements.plist.          -->
    <!-- Requiert apple-app-site-association sur le domaine.  -->
    <!-- =================================================== -->

    <!-- =================================================== -->
    <!-- BACKGROUND MODES                                     -->
    <!-- audio = pour livestream visio sans coupure si        -->
    <!--         l'app passe en background (Cercles).         -->
    <!-- remote-notification = push silencieuses pour sync.   -->
    <!-- =================================================== -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>remote-notification</string>
        <string>fetch</string>
    </array>

    <!-- =================================================== -->
    <!-- ORIENTATIONS                                         -->
    <!-- iPhone : portrait + paysage (signature PV chantier). -->
    <!-- iPad : tout supporté.                                -->
    <!-- =================================================== -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- =================================================== -->
    <!-- ITSAppUsesNonExemptEncryption                        -->
    <!-- false = pas d'export compliance (HTTPS standard).    -->
    <!-- =================================================== -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- =================================================== -->
    <!-- LOCALE PAR DÉFAUT                                    -->
    <!-- =================================================== -->
    <key>CFBundleDevelopmentRegion</key>
    <string>fr</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>fr</string>
        <string>ar</string>
        <string>en</string>
    </array>
</dict>
</plist>
