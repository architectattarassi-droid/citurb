PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/citurbarea?schema=public

ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Lead notifications (POST /api/lead-funnel/capture → email équipe) ───
# Destinataire(s) du mail "nouveau lead" (csv possible si plusieurs).
# Fallback : OWNER_EMAIL puis architectattarassi@gmail.com.
LEAD_NOTIFY_TO=architectattarassi@gmail.com

# ─── Resend (recommandé sur Railway : SMTP sortant bloqué en hobby) ──────
# Crée la clé sur https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx
# RESEND_FROM=CITURBAREA <noreply@citurbarea.com>

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Chat cible des notifs monitoring (B2+). Fallback sur TELEGRAM_ADMIN_CHAT_ID.
# Récup : écrire au bot puis GET api.telegram.org/bot<token>/getUpdates (ou @userinfobot).
TELEGRAM_CHAT_ID=

OPS_BASE_URL=http://localhost:5173/ops

# Dev-only: enables public demo endpoints for P1 tunnel (no DB).
ENABLE_PUBLIC_DEMO=true

# ════════════════════════════════════════════════════════════════════════
# MONITORING — module `monitoring` (Sprint monitoring-notifications)
# ════════════════════════════════════════════════════════════════════════

# ─── B1 · Analytics Umami (auto-hébergé, sans cookies) ───────────────────
# AnalyticsService interroge l'API Umami pour les rapports visites.
# UMAMI_BASE_URL : URL publique du service Umami (sans slash final).
# UMAMI_WEBSITE_ID : id du site "citurbarea" créé dans Umami (Settings → Websites).
# Auth (un des deux) : API key (recommandé, pas d'expiration) OU username/password.
UMAMI_BASE_URL=
UMAMI_WEBSITE_ID=
# Option A — API key (Umami → Settings → API keys)
UMAMI_API_KEY=
# Option B — login (fallback si pas d'API key) : token renouvelé auto sur 401
UMAMI_USERNAME=
UMAMI_PASSWORD=

# ─── B2 · Notifications instantanées nouveau dossier (Email + Telegram) ───
# Canaux activés par défaut ; mettre "false" pour désactiver un canal.
NOTIFY_EMAIL_ENABLED=true
NOTIFY_TELEGRAM_ENABLED=true
# Destinataire des emails de notif dossier. Fallback : OWNER_EMAIL → LEAD_NOTIFY_TO → ALERT_EMAIL_TO.
# (L'email passe par EmailService : Resend si RESEND_API_KEY, sinon SMTP.)
NOTIFY_EMAIL_TO=
# Telegram réutilise TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID (ci-dessus).

# ─── B3 · Rapport quotidien visites (cron) ───────────────────────────────
# Cron (TZ Africa/Casablanca). Défaut : 08:00 chaque jour. Lu au démarrage.
REPORT_DAILY_CRON=0 8 * * *
# Activation du cron quotidien (l'endpoint POST .../reports/daily/run reste dispo).
REPORT_DAILY_ENABLED=true

# ─── B4 · Rapport hebdomadaire SEO/GEO (cron) ────────────────────────────
# Cron (TZ Africa/Casablanca). Défaut : lundi 08:00.
REPORT_WEEKLY_CRON=0 8 * * 1
REPORT_WEEKLY_ENABLED=true
# Santé crawlabilité — URLs prioritaires auditées côté serveur (anti-régression rendu).
# CSV de chemins (résolus contre la base) ou URLs absolues. Doivent être SERVEUR-RENDUES.
# Défaut : home + pages SEO statiques.
REPORT_CRAWL_BASE_URL=https://citurbarea.com
# REPORT_CRAWL_URLS=/,/services/architecte-sale.html,/fr/permis-de-construire
# Volet SEO Google Search Console — OPTIONNEL, désactivé par défaut.
GSC_ENABLED=false
# GSC_SITE_URL=https://citurbarea.com/         # ou sc-domain:citurbarea.com
# Credentials service-account (un des deux) :
# GSC_SERVICE_ACCOUNT_JSON=                     # JSON brut OU base64 du fichier de clé
# GSC_CLIENT_EMAIL=xxx@yyy.iam.gserviceaccount.com
# GSC_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
