}

model PhaseHistorique {
  id         String   @id @default(cuid())
  dossierId  String
  phaseRef   String
  action     String
  acteurId   String?
  acteurRole String?
  acteurNom  String?
  details    Json?
  note       String?
  createdAt  DateTime @default(now())
  dossier    Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@index([phaseRef])
}

// ==============================
// CERCLES PROFESSIONNELS — réseau pro CITURBAREA
// Spec : CERCLES-prompt-claude-code.md
// Architecture : Cercles + Memberships + Posts + LiveRooms (LiveKit) + Egress multi-RTMP
// ==============================

enum CercleVisibility {
  PUBLIC
  MEMBERS_ONLY
  PRIVATE
}

enum CercleRole {
  MEMBER
  CONTRIBUTOR
  MODERATOR
  OWNER
}

enum MembershipStatus {
  PENDING_REQUEST
  PENDING_INVITE
  PENDING_APPLICATION // dossier d'adhésion à valider (associations)
  ACTIVE
  BANNED
  LEFT
}

// Type de flow d'adhésion d'un Cercle
enum MembershipFlow {
  SIMPLE // rejoindre direct ou demande simple (Cercles thématiques)
  ASSOCIATION // dossier d'adhésion + validation modo (SNASP, ANJAUM, ordres pro)
}

// Type de membre dans une association (cas Cercle ASSOCIATION uniquement)
enum AssociationMemberType {
  ASPIRANT // candidature en cours
  ETUDIANT // étudiant école d'archi/urba
  JEUNE_DIPLOME // diplômé récent (< 5 ans)
  ACTIF // membre titulaire à jour
  HONORAIRE // membre honoraire
  RETRAITE // membre retraité
}

// Statut cotisation annuelle
enum CotisationStatus {
  NON_REQUISE // cercle sans cotisation
  EN_ATTENTE // membre validé mais cotisation pas reçue
  A_JOUR // cotisation payée et valide
  EXPIRE // période cotisation expirée
}

enum AssociationApplicationStatus {
  PENDING // soumise, en attente d'examen
  APPROVED // validée par modo
  REJECTED // refusée par modo (avec raison)
  CANCELLED // annulée par le candidat
}

enum RoomStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum StreamPlatform {
  YOUTUBE
  FACEBOOK_PAGE
  LINKEDIN_LIVE
  CUSTOM_RTMP
}

enum RoomProvider {
  LIVEKIT // visio interne CITURBAREA (rooms < 50, contrôle fin)
  JITSI // visio publique partageable (8x8.vc JaaS ou meet.jit.si fallback)
}

enum EgressStatus {
  IDLE
  STARTING
  ACTIVE
  STOPPING
  ENDED
  FAILED
}

model Cercle {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String?
  visibility  CercleVisibility @default(MEMBERS_ONLY)

  region String? // une des 12 régions marocaines (nullable = national)
  themes String[] // tags ["BIM", "VRD lotissements", ...]

  // Flow d'adhésion : SIMPLE (rejoindre direct) ou ASSOCIATION (dossier + validation)
  membershipFlow        MembershipFlow @default(SIMPLE)
  // Schéma JSON des champs requis dans le formulaire d'adhésion (ASSOCIATION only)
  // Format: [{ name, label, type, required, options?, validation? }]
  formSchema            Json?
  // Critères d'éligibilité (display info, pas validation auto): age max, école requise, etc.
  eligibilityCriteria   Json?
  // Cotisation annuelle en MAD (null = pas de cotisation)
  cotisationAnnuelleMad Int?
  // Préfixe pour numéro de carte (ex: "ANJAUM-2026" → ANJAUM-2026-0042)
  cardNumberPrefix      String?

  ownerId String
  owner   User   @relation("CercleOwner", fields: [ownerId], references: [id])

  // Cabinet d'appartenance — multi-cabinet isolation via firmId existant
  firmId String?
  firm   Firm?   @relation("CercleFirm", fields: [firmId], references: [id])

  moderators   CercleModerator[]
  members      CercleMembership[]
  posts        CerclePost[]
  messages     CercleMessage[]
  rooms        LiveRoom[]
  invitations  CercleInvitation[]
  applications AssociationMembershipApplication[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete uniquement

  @@index([firmId])
  @@index([visibility, deletedAt])
}

model CercleMembership {
  id       String           @id @default(cuid())
  cercleId String
  cercle   Cercle           @relation(fields: [cercleId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation("CercleMemberships", fields: [userId], references: [id])
  role     CercleRole       @default(MEMBER)
  status   MembershipStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())
  leftAt   DateTime?

  // Champs spécifiques aux Cercles ASSOCIATION (SNASP, ANJAUM, ordres pro)
  memberType         AssociationMemberType?
  cotisationStatus   CotisationStatus                  @default(NON_REQUISE)
  cotisationExpireAt DateTime?
  cardNumber         String?                           @unique // ex: ANJAUM-2026-0042
  applicationId      String?                           @unique // référence à l'application validée
  application        AssociationMembershipApplication? @relation(fields: [applicationId], references: [id])

  @@unique([cercleId, userId])
  @@index([userId])
  @@index([cotisationStatus, cotisationExpireAt])
}

// Dossier d'adhésion à une association professionnelle (SNASP, ANJAUM, etc.)
model AssociationMembershipApplication {
  id       String @id @default(cuid())
  cercleId String
  cercle   Cercle @relation(fields: [cercleId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation("UserApplications", fields: [userId], references: [id])

  status     AssociationApplicationStatus @default(PENDING)
  // Données du formulaire (correspond au formSchema du Cercle)
  formData   Json
  // Type de membre souhaité (étudiant, jeune diplômé, actif)
  memberType AssociationMemberType?

  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedBy      String? // userId du modo qui a validé/rejeté
  reviewNote      String?   @db.Text
  rejectionReason String?   @db.Text

  // Membership lié (créé à l'approbation)
  membership CercleMembership?

  @@index([cercleId, status])
  @@index([userId])
  @@index([status, submittedAt])
}

model CercleModerator {
  id        String   @id @default(cuid())
  cercleId  String
  cercle    Cercle   @relation(fields: [cercleId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("CercleModerators", fields: [userId], references: [id])
  grantedAt DateTime @default(now())

  @@unique([cercleId, userId])
}

model CerclePost {
  id       String  @id @default(cuid())
  // cercleId NULL = post général (fil public, visible/partageable par tous, indexable SEO).
  // cercleId défini = post de cercle (visible uniquement par les pros connectés / membres).
  cercleId String?
  cercle   Cercle? @relation(fields: [cercleId], references: [id], onDelete: Cascade)
  authorId String
  author   User    @relation("CerclePostAuthor", fields: [authorId], references: [id])

  title String?
  body  String  @db.Text // markdown autorisé, sanitizé serveur

  attachments PostAttachment[]
  upvotedBy   PostUpvote[]

  parentId String?
  parent   CerclePost?  @relation("Replies", fields: [parentId], references: [id])
  replies  CerclePost[] @relation("Replies")

  upvotes    Int @default(0)
  replyCount Int @default(0)

  isPinned   Boolean @default(false)
  isResolved Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([cercleId, createdAt(sort: Desc)])
  @@index([parentId])
}

model PostAttachment {
  id        String     @id @default(cuid())
  postId    String
  post      CerclePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  fileKey   String // S3 key (bucket Cercles)
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime   @default(now())
}

// Like d'un post (tracking par user pour permettre toggle + éviter double-like)
model PostUpvote {
  id        String     @id @default(cuid())
  postId    String
  post      CerclePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation("UserPostUpvotes", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([postId, userId])
  @@index([userId])
  @@index([postId])
}

model LiveRoom {
  id       String @id @default(cuid())
  cercleId String
  cercle   Cercle @relation(fields: [cercleId], references: [id], onDelete: Cascade)
  hostId   String
  host     User   @relation("LiveRoomHost", fields: [hostId], references: [id])

  slug        String  @unique
  title       String
  description String?

  // Provider — cohabitation LiveKit (interne) / Jitsi (public partageable)
  provider        RoomProvider @default(LIVEKIT)
  livekitRoomName String       @unique
  jitsiRoomName   String?      @unique // utilisé seulement si provider = JITSI

  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?

  maxParticipants Int     @default(50)
  isRecording     Boolean @default(false)
  isLiveBroadcast Boolean @default(false)

  status RoomStatus @default(SCHEDULED)

  egressTargets EgressTarget[]

  recordingUrl         String?
  recordingDurationSec Int?

  participants RoomParticipation[]

  createdAt DateTime @default(now())

  @@index([cercleId, scheduledAt])
  @@index([status])
}

model RoomParticipation {
  id          String    @id @default(cuid())
  roomId      String
  room        LiveRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("RoomParticipant", fields: [userId], references: [id])
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  durationSec Int?

  @@unique([roomId, userId])
}

model EgressTarget {
  id     String   @id @default(cuid())
  roomId String
  room   LiveRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  platform  StreamPlatform
  rtmpUrl   String
  streamKey String // chiffré au repos AES-256-GCM (iv:authTag:ciphertext base64)
  label     String

  status          EgressStatus @default(IDLE)
  livekitEgressId String?
  startedAt       DateTime?
  endedAt         DateTime?
  errorMessage    String?

  createdAt DateTime @default(now())
}

// ==============================
// CHAT TEMPS RÉEL — messages de cercle
// Sprint E1-E3 : CercleMessage, MessageAttachment, MessageReaction, MessageRead
// ==============================

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

model CercleMessage {
  id       String @id @default(cuid())
  cercleId String
  cercle   Cercle @relation(fields: [cercleId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation("CercleMessageAuthor", fields: [authorId], references: [id])

  body String @db.Text // peut être vide si attachements seuls

  // Reply 1 niveau (style WhatsApp/Messenger)
  replyToId String?
  replyTo   CercleMessage?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   CercleMessage[] @relation("MessageReplies")

  attachments MessageAttachment[]
  reactions   MessageReaction[]
  reads       MessageRead[]

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([cercleId, createdAt])
  @@index([cercleId, deletedAt])
  @@index([authorId])
}

model MessageAttachment {
  id          String         @id @default(cuid())
  messageId   String
  message     CercleMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type        AttachmentType
  fileKey     String // chemin sous uploads/cercles-chat/<cercleId>/<file>
  filename    String
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  durationSec Int?
  posterKey   String? // poster image pour vidéo (frame extraite ou thumbnail uploadé)
  createdAt   DateTime       @default(now())

  @@index([messageId])
}

model MessageReaction {
  id        String        @id @default(cuid())
  messageId String
  message   CercleMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation("MessageReactionUser", fields: [userId], references: [id])
  emoji     String // 👍 ❤️ 😂 😮 😢 🙏 (whitelist côté serveur)
  createdAt DateTime      @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model MessageRead {
  id        String        @id @default(cuid())
  messageId String
  message   CercleMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation("MessageReadUser", fields: [userId], references: [id])
  readAt    DateTime      @default(now())

  @@unique([messageId, userId])
  @@index([userId])
}

// ==============================
// MESSAGERIE DIRECTE — Sprint L
// 1-to-1 DMs entre pros (style LinkedIn/Messenger)
// ==============================

model DirectThread {
  id               String   @id @default(cuid())
  // sha256 trié des userIds pour déduplication (2 users → 1 seul thread possible)
  participantsHash String   @unique
  createdAt        DateTime @default(now())
  lastMessageAt    DateTime @default(now())
  lastMessageBody  String?  @db.Text

  participants DirectThreadParticipant[]
  messages     DirectMessage[]

  @@index([lastMessageAt])
}

model DirectThreadParticipant {
  threadId    String
  thread      DirectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation("DTParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt    DateTime     @default(now())
  leftAt      DateTime?
  unreadCount Int          @default(0)
  lastReadAt  DateTime?
  mutedUntil  DateTime?
  pinned      Boolean      @default(false)

  @@id([threadId, userId])
  @@index([userId])
}

model DirectMessage {
  id          String       @id @default(cuid())
  threadId    String
  thread      DirectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User         @relation("DMSender", fields: [senderId], references: [id])
  body        String       @db.Text
  // Attachements simples (urls images/videos uploadées via /uploads ou liens YouTube)
  attachments Json? // [{ type: 'image'|'video'|'file'|'embed', url, filename?, mime?, size? }]
  createdAt   DateTime     @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?

  @@index([threadId, createdAt])
  @@index([senderId])
}

// ==============================
// MARKETPLACE BTP — Sprint M+ (modèle référentiel + offres)
// MarketProduct = catalogue maître des matériaux (pré-chargé,
// organisé par corps de métier). SupplierOffer = offre d'un
// fournisseur sur un produit du référentiel (prix, stock, livraison).
// ==============================

model MarketProduct {
  id          String  @id @default(cuid())
  citCode     String? @unique // code CITURBAREA matériau : CIT-GO-001, CIT-PL-012…
  corpsMetier String // GROS_OEUVRE, PLOMBERIE, ELECTRICITE, ETANCHEITE…
  famille     String // "Liants", "Granulats", "Aciers"…
  name        String
  slug        String  @unique
  description String? @db.Text
  unit        String  @default("UNITE") // M3 M2 ML T KG SAC UNITE PALETTE
  photo       String? // image de référence

  // Fourchette de prix indicative (affichée même sans offre)
  indicativePriceMin Float?
  indicativePriceMax Float?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers SupplierOffer[]

  @@index([corpsMetier])
  @@index([famille])
  @@index([active])
}

model SupplierOffer {
  id              String        @id @default(cuid())
  marketProductId String
  marketProduct   MarketProduct @relation(fields: [marketProductId], references: [id], onDelete: Cascade)
  supplierId      String
  supplier        User          @relation("SupplierOffers", fields: [supplierId], references: [id], onDelete: Cascade)

  priceDH            Float
  quantityAvailable  Int?
  minOrder           Int?
  showroomCity       String?
  deliveryZones      String[]
  deliveryDelayHours Int?
  deliveryCostDH     Float?
  deliveryIncluded   Boolean  @default(false)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([marketProductId, supplierId])
  @@index([marketProductId])
  @@index([supplierId])
}

// ==============================
// ANNUAIRE PRO — réseau social BTP marocain
// Sprint D1 : ProProfile, Connection, Notification
// ==============================

enum ProMetier {
  ARCHITECTE
  BET_STRUCTURE
  BET_FLUIDES
  BET_VRD
  TOPOGRAPHE
  GEOMETRE
  CONTROLE_TECHNIQUE
  LABORATOIRE
  ENTREPRISE_GO
  ENTREPRISE_SECOND_OEUVRE
  FOURNISSEUR_MATERIAUX
  PROMOTEUR
  MOA_PUBLIQUE
  MOA_PRIVEE
  ARTISAN_QUALIFIE
}

enum ProClasseBTP {
  CL1 // jusqu'à 1 MMAD
  CL2 // jusqu'à 5 MMAD
  CL3 // jusqu'à 25 MMAD
  CL4 // jusqu'à 100 MMAD
  CL5 // au-delà de 100 MMAD
  HC // hors classe (pas concerné — architectes, fournisseurs)
}

enum ProProfileProjectStatus {
  ETUDE
  EN_COURS
  LIVRE
}

enum ProProfileMediaType {
  PHOTO
  VIDEO_FILE
  VIDEO_URL
}

model ProProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("UserProProfile", fields: [userId], references: [id], onDelete: Cascade)

  // Identité publique
  displayName String
  title       String? // "Architecte associé", "Directeur technique", etc.
  bio         String? @db.Text
  avatarUrl   String?
  coverUrl    String?

  // Méta-métier
  metier      ProMetier
  classeBTP   ProClasseBTP?
  agrements   String[] // ["CNOA-12345", "ONI-654", "AGREMENT_MEFD_BAT_CL3"]
  specialites String[] // tags libres : "BIM", "Béton précontraint", "Terre crue"…
  cnoaNumero  String? // numéro d'inscription Conseil National (architectes uniquement)

  // Cabinet / structure
  cabinetName     String? // "Atelier Bensouda", "BET Idrissi"
  cabinetSize     Int? // nombre de collaborateurs
  cabinetStatus   String? // "LIBERAL" | "ASSOCIE" | "SALARIE" | "FONCTIONNAIRE" | "INDEPENDANT"
  yearsExperience Int? // années d'expérience pro

  // Formations & certifications & prix
  formations     Json? // [{ ecole, diplome, annee, ville }]
  certifications String[] // ["Revit Certified Pro", "BIM Manager", "RT-Maroc Auditeur"]
  prix           String[] // récompenses ["Prix CNOA Jeune Architecte 2018"]
  langues        String[] // ["FR", "AR", "EN", "BERBERE", "ES"]

  // Projets phares (portfolio)
  experiencesPhares Json? // [{ titre, description, anneeLivraison, surface, lieu, role, imageUrls[] }] (legacy — conservé)

  // Fiche cabinet publique (SEO) — portfolio normalisé
  slug              String?             @unique // handle public: /cabinet/:slug
  portfolioProjects ProProfileProject[]

  // Localisation
  regions         String[] // 12 régions Maroc où le pro intervient
  villePrincipale String?

  // Tarifs et disponibilité
  tarifsRange       String? // ex "Honoraires 4–6% du coût travaux", "Forfait 30–80k MAD"
  disponibilite     String?   @default("DISPONIBLE") // "DISPONIBLE" | "OCCUPE" | "INDISPONIBLE"
  disponibleAPartir DateTime?

  // Réseaux + identité publique
  websiteUrl   String?
  linkedinUrl  String?
  behanceUrl   String?
  instagramUrl String?
  pinterestUrl String?
  phonePublic  String?
  emailPublic  String?

  // Vérification
  isVerified   Boolean   @default(false) // badge bleu
  verifiedAt   DateTime?
  verifierNote String?

  // Marketplace : contrat fournisseur signé avec CITURBAREA.
  // Tant que null → identité du fournisseur masquée sur la marketplace.
  supplierContractSignedAt DateTime?
  // Code CITURBAREA fournisseur : CIT-FRN-00001 (attribué à la 1re offre).
  supplierCitCode          String?   @unique

  // Stats dérivées (optionnel — peut rester null et calculé à la volée)
  projectsCount    Int @default(0)
  connectionsCount Int @default(0)
  profileViews     Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([metier])
  @@index([classeBTP])
  @@index([disponibilite])
}

model ProProfileProject {
  id           String                  @id @default(cuid())
  proProfileId String
  proProfile   ProProfile              @relation(fields: [proProfileId], references: [id], onDelete: Cascade)
  slug         String
  title        String
  type         String // Résidentiel, Administratif, Urbanisme…
  location     String // ville
  surface      Int? // m²
  year         Int?
  status       ProProfileProjectStatus @default(ETUDE)
  missions     String[]
  programme    String?                 @db.Text
  description  String                  @db.Text
  materials    String?
  keywords     String[]
  published    Boolean                 @default(false)
  media        ProProfileMedia[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([proProfileId, slug])
  @@index([type])
  @@index([location])
}

model ProProfileMedia {
  id           String              @id @default(cuid())
  projectId    String
  project      ProProfileProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         ProProfileMediaType
  url          String // URL CDN (R2) ou lien YouTube/Vimeo
  thumbnailUrl String? // requis pour VIDEO_* (VideoObject)
  alt          String? // SEO, généré
  caption      String?
  width        Int?
  height       Int?
  durationSec  Int?
  uploadDate   DateTime            @default(now()) // requis pour VideoObject
  position     Int                 @default(0)
  createdAt    DateTime            @default(now())

  @@index([projectId])
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

// ==============================
// APP ADMIN ULTRA-SÉCURISÉE — Sprint H
// Table séparée de User (silos étanches). 10 couches de protection.
// ==============================

enum AdminRole {
  SUPER_ADMIN // contrôle total ; un seul autorisé en DB (garde-fou)
  ADMIN_AUDIT // lecture + audit log + export RGPD ; pas de kill switch
  ADMIN_SUPPORT // lecture + suspendre user/contenu ; pas de DB override
  ADMIN_READ_ONLY // lecture seule (dashboard + logs uniquement)
}

enum AdminSessionStep {
  PASSWORD_OK // étape 1 : password validé
  EMAIL_OTP_OK // étape 2 : OTP email validé
  SMS_OTP_OK // étape 3 : OTP SMS validé
  WEBAUTHN_OK // étape 4 : WebAuthn / passkey validé
  FULLY_AUTH // toutes étapes franchies, session active (JWT émis)
  REVOKED // kill-switch, fingerprint diff, suspicion vol token
  EXPIRED // TTL atteint
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String // bcrypt cost 14
  role         AdminRole @default(SUPER_ADMIN)
  displayName  String

  // Contacts pour OTP
  phoneE164       String?
  phoneVerifiedAt DateTime?
  emailVerifiedAt DateTime?

  // Kill-switch admin lui-même
  isActive        Boolean   @default(true)
  suspendedAt     DateTime?
  suspendedReason String?

  // Sécurité runtime
  failedAttempts       Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  lastLoginIp          String?
  lastLoginFingerprint String?
  loginCount           Int       @default(0)

  // Création (audit qui-a-créé-qui)
  createdById String? // null pour le SUPER_ADMIN initial (seed)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions    AdminSession[]
  credentials WebAuthnCredential[]
  auditLogs   AdminAuditLog[]
  allowedIps  AdminAllowedIp[]
  alerts      AdminAlert[]

  @@index([role])
  @@index([isActive])
}

model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  step         AdminSessionStep @default(PASSWORD_OK)
  sessionToken String           @unique // token éphémère qui débloque l'étape suivante (32 bytes random base64url)

  // JWT final (généré seulement si step=FULLY_AUTH)
  jwtJti       String?   @unique // jti du JWT pour révocation
  jwtIssuedAt  DateTime?
  jwtExpiresAt DateTime? // typiquement +15min

  // Contexte de connexion (immuable)
  ipAddress         String
  userAgent         String @db.Text
  deviceFingerprint String // hash SHA-256 (UA + canvas + WebGL + screen)

  // Étapes franchies (timestamp pour audit)
  passwordOkAt DateTime?
  emailOtpOkAt DateTime?
  smsOtpOkAt   DateTime?
  webauthnOkAt DateTime?
  fullyAuthAt  DateTime?

  // Lifecycle
  expiresAt     DateTime // TTL global de l'attempt (30min)
  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([adminUserId, step])
  @@index([sessionToken])
  @@index([jwtJti])
  @@index([revokedAt])
}

model AdminAllowedIp {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  cidr  String // ex "41.140.0.0/16" ou "192.168.1.5/32"
  label String // "Mon PC bureau Casa", "Mobile 4G IAM"

  addedAt    DateTime  @default(now())
  lastSeenAt DateTime?
  revokedAt  DateTime?

  @@index([adminUserId])
}

model WebAuthnCredential {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  credentialId String   @unique // base64url du credentialId WebAuthn
  publicKey    String   @db.Text // base64 de la clé publique COSE
  counter      Int      @default(0)
  deviceType   String? // "Windows Hello PC bureau", "YubiKey 5C NFC backup"
  transports   String[] // ["internal", "usb", "nfc", "ble", "hybrid"]
  aaguid       String? // identifiant authenticateur (modèle de YubiKey, etc.)

  addedAt    DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([adminUserId])
}

model AdminAuditLog {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])

  // Hash chain immuable (SHA-256 du log précédent + payload)
  prevHash String?
  hash     String  @unique

  // Event
  action   String // "ADMIN_LOGIN", "USER_SUSPEND", "DOSSIER_OVERRIDE_STATUS", "IMPERSONATE_START"…
  category String // "AUTH", "USER", "CERCLE", "DOSSIER", "PAYMENT", "EXPORT", "SYSTEM"
  severity String // "INFO", "WARN", "CRITICAL"

  // Cible (optionnel)
  targetType String? // "User", "Cercle", "Dossier", "Payment", "AdminUser"
  targetId   String?

  // Détails contextuels (jamais de secrets en clair)
  payload Json?

  // Contexte HTTP
  ipAddress         String?
  userAgent         String? @db.Text
  deviceFingerprint String?
  sessionId         String?

  createdAt DateTime @default(now())

  @@index([adminUserId, createdAt])
  @@index([action])
  @@index([category, severity])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model AdminAlert {
  id          String     @id @default(cuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  severity String // "INFO", "WARN", "CRITICAL"
  category String // "LOGIN_NEW_IP", "FAILED_ATTEMPTS", "KILL_SWITCH", "EXPORT_RGPD", "WEBAUTHN_ADDED"
  title    String
  message  String @db.Text

  // Canaux de delivery
  channelEmail     Boolean   @default(false)
  channelSms       Boolean   @default(false)
  emailDeliveredAt DateTime?
  smsDeliveredAt   DateTime?

  // Lifecycle
  readAt         DateTime?
  acknowledgedAt DateTime?

  createdAt DateTime @default(now())

  @@index([adminUserId, readAt])
  @@index([severity, createdAt])
}

// Sliding-window rate limiter (key = "login:email@x" ou "login:ip:...")
model AdminRateLimit {
  id          String    @id @default(cuid())
  key         String    @unique
  attempts    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?

  @@index([lockedUntil])
}

model Connection {
  id          String           @id @default(cuid())
  fromUserId  String
  fromUser    User             @relation("ConnectionFrom", fields: [fromUserId], references: [id])
  toUserId    String
  toUser      User             @relation("ConnectionTo", fields: [toUserId], references: [id])
  status      ConnectionStatus @default(PENDING)
  message     String? // mot accompagnant la demande
  respondedAt DateTime?
  createdAt   DateTime         @default(now())

  @@unique([fromUserId, toUserId])
  @@index([fromUserId])
  @@index([toUserId])
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  CERCLE_INVITE
  CERCLE_REQUEST_APPROVED
  POST_REPLY
  POST_MENTION
  ROOM_STARTING
  ROOM_INVITE
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  // Lien d'action — ouvre cette URL au clic
  actionUrl String?
  // Référence libre vers entité concernée
  refType   String? // "cercle" | "post" | "room" | "connection"
  refId     String?
  // Lecture
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ==============================
// INVITATIONS PAR EMAIL — onboarding via lien magique
// Sprint F2
// ==============================

model CercleInvitation {
  id          String    @id @default(cuid())
  token       String    @unique // utilisé dans l'URL /inscription?invite=<token>
  cercleId    String
  cercle      Cercle    @relation(fields: [cercleId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User      @relation("CercleInvitationInviter", fields: [invitedById], references: [id])
  email       String // email du destinataire (l'utilisateur peut ne pas exister encore)
  message     String? // mot d'accompagnement de l'invitant
  expiresAt   DateTime
  usedAt      DateTime? // marqué quand le destinataire a créé son compte
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([cercleId])
  @@index([token])
}

// ==============================
// ARTICLES — Media / Blog (Sprint Articles 2026-06)
// Articles publiés sur la plateforme avec vignettes Open Graph par article.
// Slug unique pour URL SEO-friendly (/media/article/loi-34-21-tajzi-2).
// status PUBLISHED + cover JPG/PNG → robots WhatsApp/FB/LinkedIn voient une vraie vignette.
// ==============================

enum ArticleStatus {
  DRAFT
  PUBLISHED
  REJECTED
}

model Article {
  id    String @id @default(cuid())
  /// Slug URL unique (kebab-case), ex: "loi-34-21-tajzi-2"
  slug  String @unique
  title String

  /// "fr" | "ar" | "en" — gardé String pour flexibilité multi-langues
  lang     String @default("fr")
  /// "terrain" | "urbanisme" | "autorisation" | "chantier" | "budget" | "investissement" | "juridique" | "autre"
  category String

  /// Tags libres (JSON array, ex: ["loi 34-21", "tajzi'a", "CNOA"])
  tags String[] @default([])

  /// Chapeau / extrait pour cards et metadata description (155 chars max recommandé)
  excerpt String
  /// Contenu HTML rendu safe via dangerouslySetInnerHTML
  content String @db.Text

  /// URL de la cover (JPG/PNG, ratio 1.91:1 ou 16:9), utilisée comme og:image
  cover       String?
  /// Hauteur cover en pixels (pour og:image:height)
  coverWidth  Int?
  /// Largeur cover en pixels (pour og:image:width)
  coverHeight Int?

  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?

  /// Auteur (nullable car articles seed peuvent être anonymes initialement)
  authorId   String?
  author     User?   @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Nom affiché si pas d'authorId (auteur invité, externe)
  authorName String?

  /// Compteur de vues (incrémenté à chaque GET /api/articles/:slug)
  views Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@index([category, status])
  @@index([lang, status])
  @@index([authorId])
}
