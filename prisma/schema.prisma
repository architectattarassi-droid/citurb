model DossierVisio {
  id             String   @id @default(cuid())
  dossierId      String
  organisateurId String
  participants   String[]
  lienVisio      String
  provider       String   @default("WHEREBY")
  roomName       String
  dateHeure      DateTime
  dureeEstimee   Int?
  statut         String   @default("PLANIFIEE")
  phaseRef       String?
  objet          String?
  recordingPath  String?
  dossier        Dossier  @relation(fields: [dossierId], references: [id])
  createdAt      DateTime @default(now())
}

model Prestataire {
  id             String                @id @default(cuid())
  nom            String
  type           String
  specialites    String[]
  communes       String[]
  note           Float                 @default(0)
  certifications String[]
  ice            String?
  tel            String?
  email          String?
  actif          Boolean               @default(true)
  commandes      CommandePrestataire[]
  createdAt      DateTime              @default(now())
}

model CommandePrestataire {
  id            String       @id @default(cuid())
  dossierId     String
  prestataireId String?
  phase         String
  lot           String?
  type          String
  montant       Float?
  statut        String       @default("EN_ATTENTE")
  declencheTCE  Boolean      @default(false)
  dossier       Dossier      @relation(fields: [dossierId], references: [id])
  prestataire   Prestataire? @relation(fields: [prestataireId], references: [id])
